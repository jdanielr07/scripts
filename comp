#!/bin/bash

# Capturar Ctrl+C
trap 'printf "\033[?25h" >&2; gum style --foreground 196 "🚪 Saliendo..."; exit 0' INT

# Archivo de configuración
CONFIG_FILE="$HOME/.comp_config"

# Función para leer configuración
read_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        cat "$CONFIG_FILE"
    else
        echo "tar.gz"  # Valor por defecto
    fi
}

# Función para escribir configuración
write_config() {
    echo "$1" > "$CONFIG_FILE"
}

# Función para generar nombre único de archivo
generate_unique_filename() {
    local base_name="$1"
    local counter=1
    local filename="$base_name"
    
    while [[ -f "$filename" ]]; do
        # Separar nombre y extensión
        local name_without_ext="${base_name%.*}"
        local extension="${base_name##*.}"
        
        if [[ "$name_without_ext" == "$base_name" ]]; then
            # No hay extensión
            filename="${base_name}($counter)"
        else
            # Hay extensión
            filename="${name_without_ext}($counter).${extension}"
        fi
        
        ((counter++))
    done
    
    echo "$filename"
}

# Función para mostrar configuración actual
show_config() {
    local current_config=$(read_config)
    echo -n "$(gum style --foreground 51 "🔧 Configuración actual: ")"
    gum style --foreground 212 "$current_config"
}

# Función para cambiar configuración
change_config() {
    local current_config=$(read_config)
    local options=("tar.gz" "tar.bz2" "tar.xz" "tar.zst" "7z" "zip")
    
    if ! choose_option "Selecciona el tipo de compresión" "x  Abortar" "${options[@]}"; then
        return
    fi
    local new_config="$CHOICE"

    write_config "$new_config"
    gum style --foreground 82 "✅ Configuración actualizada a: $new_config"

    # Verificar e instalar dependencias para el nuevo tipo
    check_dependency_silent "$new_config"
}

# Función para detectar el sistema operativo y gestor de paquetes
detect_package_manager() {
    if command -v apt-get &> /dev/null; then
        echo "apt"
    elif command -v dnf &> /dev/null; then
        echo "dnf"
    elif command -v yum &> /dev/null; then
        echo "yum"
    elif command -v pacman &> /dev/null; then
        echo "pacman"
    elif command -v zypper &> /dev/null; then
        echo "zypper"
    elif command -v brew &> /dev/null; then
        echo "brew"
    else
        echo "unknown"
    fi
}

# Función para obtener comando de instalación de gum
get_gum_install_command() {
    local pkg_manager=$(detect_package_manager)
    case $pkg_manager in
        "apt")
            echo "sudo apt-get update && sudo apt-get install -y gum"
            ;;
        "dnf")
            echo "sudo dnf install -y gum"
            ;;
        "yum")
            echo "sudo yum install -y gum"
            ;;
        "pacman")
            echo "sudo pacman -S gum"
            ;;
        "zypper")
            echo "sudo zypper install gum"
            ;;
        "brew")
            echo "brew install gum"
            ;;
        *)
            echo "echo '❌ No se pudo detectar el gestor de paquetes. Instala gum manualmente desde: https://github.com/charmbracelet/gum'"
            ;;
    esac
}

# Función para comprimir según el tipo configurado
compress_folder() {
    local folder="$1"
    local output_file="$2"
    local compression_type="$3"
    
    case "$compression_type" in
        "tar.gz")
            gum spin --spinner dot --title "Comprimiendo con tar + gzip..." -- \
                tar --exclude="$folder/node_modules" \
                    --exclude="$folder/vendor" \
                    -cvf - "$folder" | gzip > "$output_file"
            ;;
        "tar.bz2")
            gum spin --spinner dot --title "Comprimiendo con tar + bzip2..." -- \
                tar --exclude="$folder/node_modules" \
                    --exclude="$folder/vendor" \
                    -cvf - "$folder" | bzip2 > "$output_file"
            ;;
        "tar.xz")
            gum spin --spinner dot --title "Comprimiendo con tar + xz..." -- \
                tar --exclude="$folder/node_modules" \
                    --exclude="$folder/vendor" \
                    -cvf - "$folder" | xz > "$output_file"
            ;;
        "tar.zst")
            gum spin --spinner dot --title "Comprimiendo con tar + zstd..." -- \
                tar --exclude="$folder/node_modules" \
                    --exclude="$folder/vendor" \
                    -cvf - "$folder" | zstd > "$output_file"
            ;;
        "7z")
            gum spin --spinner dot --title "Comprimiendo con 7z..." -- \
                7z a -t7z -m0=lzma2 -mx=9 "$output_file" "$folder" -xr!"$folder/node_modules" -xr!"$folder/vendor" > /dev/null
            ;;
        "zip")
            gum spin --spinner dot --title "Comprimiendo con zip..." -- \
                zip -r "$output_file" "$folder" -x "$folder/node_modules/*" "$folder/vendor/*" > /dev/null
            ;;
        *)
            gum style --foreground 196 "❌ Tipo de compresión no válido: $compression_type"
            exit 1
            ;;
    esac
}

# Verificar si gum está instalado
if ! command -v gum &> /dev/null; then
    echo "❌ Gum no está instalado."
    echo "💡 Instálalo con: $(get_gum_install_command)"
    echo "📖 O descárgalo desde: https://github.com/charmbracelet/gum"
    exit 1
fi

# Función para instalar dependencias
install_dependency() {
    local dependency="$1"
    local pkg_manager=$(detect_package_manager)
    local first_time="$2"
    
    if [[ "$first_time" == "true" ]]; then
        gum style --foreground 51 "📦 Instalando $dependency por primera vez..."
    fi
    
    case $pkg_manager in
        "apt")
            if ! sudo apt-get update -qq && sudo apt-get install -y -qq "$dependency" >/dev/null 2>&1; then
                gum style --foreground 196 "❌ Error al instalar $dependency"
                exit 1
            fi
            ;;
        "dnf")
            if ! sudo dnf install -y -q "$dependency" >/dev/null 2>&1; then
                gum style --foreground 196 "❌ Error al instalar $dependency"
                exit 1
            fi
            ;;
        "yum")
            if ! sudo yum install -y -q "$dependency" >/dev/null 2>&1; then
                gum style --foreground 196 "❌ Error al instalar $dependency"
                exit 1
            fi
            ;;
        "pacman")
            if ! sudo pacman -S "$dependency" --noconfirm --quiet >/dev/null 2>&1; then
                gum style --foreground 196 "❌ Error al instalar $dependency"
                exit 1
            fi
            ;;
        "zypper")
            if ! sudo zypper install "$dependency" --non-interactive --quiet >/dev/null 2>&1; then
                gum style --foreground 196 "❌ Error al instalar $dependency"
                exit 1
            fi
            ;;
        "brew")
            if ! brew install "$dependency" >/dev/null 2>&1; then
                gum style --foreground 196 "❌ Error al instalar $dependency"
                exit 1
            fi
            ;;
        *)
            gum style --foreground 196 "❌ No se pudo detectar el gestor de paquetes. Instala $dependency manualmente."
            exit 1
            ;;
    esac
    
    if [[ "$first_time" == "true" ]]; then
        gum style --foreground 82 "✅ $dependency instalado correctamente"
    fi
}

# Verificar dependencias según configuración actual
check_dependencies() {
    local compression_type=$(read_config)
    case "$compression_type" in
        "tar.gz")
            if ! command -v gzip &> /dev/null; then
                install_dependency "gzip" "true"
            fi
            ;;
        "tar.bz2")
            if ! command -v bzip2 &> /dev/null; then
                install_dependency "bzip2" "true"
            fi
            ;;
        "tar.xz")
            if ! command -v xz &> /dev/null; then
                install_dependency "xz-utils" "true"
            fi
            ;;
        "tar.zst")
            if ! command -v zstd &> /dev/null; then
                install_dependency "zstd" "true"
            fi
            ;;
        "7z")
            if ! command -v 7z &> /dev/null; then
                install_dependency "p7zip" "true"
            fi
            ;;
        "zip")
            if ! command -v zip &> /dev/null; then
                install_dependency "zip" "true"
            fi
            ;;
    esac
}

# Verificar dependencias para un tipo específico (sin mensajes)
check_dependency_silent() {
    local compression_type="$1"
    case "$compression_type" in
        "tar.gz")
            if ! command -v gzip &> /dev/null; then
                install_dependency "gzip" "false"
            fi
            ;;
        "tar.bz2")
            if ! command -v bzip2 &> /dev/null; then
                install_dependency "bzip2" "false"
            fi
            ;;
        "tar.xz")
            if ! command -v xz &> /dev/null; then
                install_dependency "xz-utils" "false"
            fi
            ;;
        "tar.zst")
            if ! command -v zstd &> /dev/null; then
                install_dependency "zstd" "false"
            fi
            ;;
        "7z")
            if ! command -v 7z &> /dev/null; then
                install_dependency "p7zip" "false"
            fi
            ;;
        "zip")
            if ! command -v zip &> /dev/null; then
                install_dependency "zip" "false"
            fi
            ;;
    esac
}

# Menú con abortar visible.
# x / X o Escape cancelan. Enter elige la fila marcada.
# La opción de abortar siempre queda a la vista.
# Resultado en CHOICE. Devuelve 1 si se aborta.
choose_option() {
    local header="$1"
    local abort_label="$2"
    shift 2

    local options=("$@")
    local user_count=${#options[@]}
    local index=0
    local drawn=0
    local win=8
    local total_lines
    local key seq saved c

    CHOICE=""

    if [[ $user_count -eq 0 ]]; then
        return 1
    fi

    if [[ $user_count -lt $win ]]; then
        win=$user_count
    fi
    # encabezado + filas + separador + abortar + línea en blanco + ayuda
    total_lines=$((win + 5))

    local reset=$'\033[0m'
    local c_header=$'\033[38;5;99m'
    local c_cursor=$'\033[38;5;212m'
    local c_abort=$'\033[38;5;196m'
    local c_dim=$'\033[38;5;245m'

    restore_choose_ui() {
        printf '\033[?25h' >&2
        if [[ $drawn -eq 1 ]]; then
            printf '\033[%dA\033[J' "$total_lines" >&2
            drawn=0
        fi
    }

    draw_choose() {
        local i start=0

        if [[ $user_count -gt $win ]]; then
            if [[ $index -ge $user_count ]]; then
                start=$((user_count - win))
            elif [[ $index -ge $win ]]; then
                start=$((index - win + 1))
            fi
        fi

        if [[ $drawn -eq 1 ]]; then
            printf '\033[%dA' "$total_lines" >&2
        fi

        printf '%s%s%s\033[K\n' "$c_header" "$header" "$reset" >&2

        i=$start
        while [[ $i -lt $((start + win)) ]]; do
            if [[ $i -eq $index ]]; then
                printf '%s> %s%s\033[K\n' "$c_cursor" "${options[$i]}" "$reset" >&2
            else
                printf '  %s\033[K\n' "${options[$i]}" >&2
            fi
            i=$((i + 1))
        done

        printf '%s  ────────────%s\033[K\n' "$c_dim" "$reset" >&2

        if [[ $index -eq $user_count ]]; then
            printf '%s> %s%s\033[K\n' "$c_abort" "$abort_label" "$reset" >&2
        else
            printf '%s  %s%s\033[K\n' "$c_dim" "$abort_label" "$reset" >&2
        fi

        printf '\033[K\n' >&2
        printf '%s↑↓ mover · enter elegir · x/esc abortar%s\033[K\n' "$c_dim" "$reset" >&2
        drawn=1
    }

    printf '\033[?25l' >&2

    while true; do
        draw_choose
        key=""
        if ! IFS= read -rsn1 key; then
            restore_choose_ui
            return 1
        fi

        if [[ $key == $'\033' ]]; then
            # read -n vuelve a poner el terminal en espera, así que Esc
            # solo se distingue de una flecha leyendo con VMIN=0.
            seq=""
            saved=$(stty -g)
            stty -icanon min 0 time 1 -echo
            c=$(dd bs=1 count=1 2>/dev/null)
            if [[ -n $c ]]; then
                seq="$c"
                c=$(dd bs=1 count=1 2>/dev/null)
                seq="${seq}${c}"
            fi
            stty "$saved"

            case "$seq" in
                '[A'|'OA')
                    index=$(( (index + user_count) % (user_count + 1) ))
                    ;;
                '[B'|'OB')
                    index=$(( (index + 1) % (user_count + 1) ))
                    ;;
                *)
                    restore_choose_ui
                    return 1
                    ;;
            esac
        elif [[ $key == "x" || $key == "X" ]]; then
            restore_choose_ui
            return 1
        elif [[ $key == "k" ]]; then
            index=$(( (index + user_count) % (user_count + 1) ))
        elif [[ $key == "j" ]]; then
            index=$(( (index + 1) % (user_count + 1) ))
        elif [[ -z $key || $key == $'\r' || $key == $'\n' ]]; then
            restore_choose_ui
            if [[ $index -eq $user_count ]]; then
                return 1
            fi
            CHOICE="${options[$index]}"
            return 0
        fi
    done
}

# Función del menú principal
main_menu() {
    # Título
    gum style \
        --foreground 212 --border-foreground 212 --border double \
        --align center --width 50 --margin "1 2" --padding "1 2" \
        "COMPRIMIR CARPETAS"

    # Mostrar configuración actual
    show_config

    # Menú principal
    echo ""
    if ! choose_option "¿Qué quieres hacer?" "x  Salir" "Comprimir carpeta" "Cambiar configuración"; then
        gum style --foreground 196 "🚪 Saliendo..."
        exit 0
    fi
    action="$CHOICE"

    case "$action" in
        "Comprimir carpeta")
            local folders=()
            local dir
            for dir in */; do
                [[ -d "$dir" ]] || continue
                folders+=("${dir%/}")
            done

            if [[ ${#folders[@]} -eq 0 ]]; then
                gum style --foreground 196 "❌ No hay carpetas en este directorio."
                return
            fi

            echo ""
            if ! choose_option "Selecciona la carpeta a comprimir" "x  Abortar" "${folders[@]}"; then
                return
            fi
            CARPETA="$CHOICE"

            # Obtener configuración actual
            COMPRESSION_TYPE=$(read_config)
            
            # Preguntar nombre de archivo. Escape aborta.
            echo ""
            if ! ARCHIVO=$(gum input \
                --header "Nombre del archivo · esc para abortar" \
                --placeholder "Nombre del archivo (.$COMPRESSION_TYPE)" \
                --value "$CARPETA.$COMPRESSION_TYPE"); then
                return
            fi
            if [[ -z "$ARCHIVO" ]]; then
                ARCHIVO="$CARPETA.$COMPRESSION_TYPE"
            fi

            # Generar nombre único si el archivo ya existe
            if [[ -f "$ARCHIVO" ]]; then
                ARCHIVO=$(generate_unique_filename "$ARCHIVO")
                gum style --foreground 51 "📝 Archivo ya existe, usando: $ARCHIVO"
            fi

            # Mensaje inicial
            gum style --foreground 51 "📦 Creando archivo: $ARCHIVO"

            # Comprimir según el tipo configurado
            compress_folder "$CARPETA" "$ARCHIVO" "$COMPRESSION_TYPE"

            # Verificar si el archivo se creó correctamente
            if [[ -f "$ARCHIVO" ]]; then
                # Peso final
                TAM=$(du -h "$ARCHIVO" | cut -f1)
                gum style --foreground 82 "✅ Archivo comprimido creado: $ARCHIVO ($TAM)"
                exit 0
            else
                gum style --foreground 196 "❌ Error: No se pudo crear el archivo $ARCHIVO"
                exit 1
            fi
            ;;
        "Cambiar configuración")
            change_config
            ;;
    esac
}

# Bucle principal
while true; do
    main_menu
done
